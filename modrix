    'make:module' => ['Yeni modül iskeleti:  php modrix make:module Blog', function (array $args) {
        $name = ucfirst(preg_replace('/[^A-Za-z0-9]/', '', $args[0] ?? ''));
        if ($name === '') { echo "Kullanım: php modrix make:module Blog\n"; return 1; }

        $dir = ROOT . "/app/Modules/$name";
        if (is_dir($dir)) { echo "Modül zaten var: app/Modules/$name\n"; return 1; }

        foreach (['Controllers', 'Models', 'Views', 'Migrations', 'Middlewares'] as $sub) mkdir("$dir/$sub", 0775, true);
        $slug = strtolower($name);

        file_put_contents("$dir/routes.php", <<<PHP
        <?php
        use App\Modules\\$name\Controllers\\{$name}Controller;

        Router::group(['prefix' => '/$slug'], function () {
            Router::get('/', [{$name}Controller::class, 'index'])->name('$slug.index');
        });

        PHP);
        file_put_contents("$dir/Controllers/{$name}Controller.php", <<<PHP
        <?php
        namespace App\Modules\\$name\Controllers;

        use Core\Controller;
        use Core\View;

        class {$name}Controller extends Controller
        {
            public function index(): View
            {
                return \$this->view('$name::index', ['title' => '$name']);
            }
        }

        PHP);
        file_put_contents("$dir/Views/index.php", "<h1 class=\"text-3xl font-semibold tracking-tight\">$name</h1>\n<p class=\"mt-2 text-muted-foreground\">app/Modules/$name/Views/index.php</p>\n");
        file_put_contents("$dir/module.json", json_encode([
            'name'        => $name,
            'version'     => '1.0.0',
            'description' => '',
            'author'      => '',
            'requires'    => ['php' => '8.1'],
            'menu'        => ['site' => [['url' => $slug, 'label' => $name, 'order' => 50]], 'admin' => []],
        ], JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . "\n");
        file_put_contents("$dir/hooks.php", "<?php\n// $name modülünün hook'ları (modül aktifken yüklenir). Kullanılabilir noktalar: app/Hooks.php\n");
        foreach (['Models', 'Migrations', 'Middlewares'] as $sub) touch("$dir/$sub/.gitkeep");

        echo "Oluşturuldu: app/Modules/$name\n";
        echo "Kurmak için: php modrix module:install $name  (ya da Admin > Modüller). Rehber: docs/module-tutorial.md\n";
    }],
];

$name = $argv[1] ?? 'list';
if (!isset($commands[$name])) {
    echo "Komutlar:\n";
    foreach ($commands as $cmd => [$desc]) echo '  ' . str_pad($cmd, 18) . $desc . "\n";
    exit($name === 'list' ? 0 : 1);
}

$result = $commands[$name][1](array_slice($argv, 2));
// Komut veriyi/kodu değiştirmiş olabilir: sayfa önbelleği temizlenir
if ($name !== 'list' && class_exists(App\Services\PageCache::class)) App\Services\PageCache::flush();
exit(is_int($result) ? $result : 0);
