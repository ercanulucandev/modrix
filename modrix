#!/usr/bin/env php
<?php
// Komut satırı aracı:  php modrix <komut>
if (PHP_SAPI !== 'cli') exit;

require __DIR__ . '/core/bootstrap.php';

use Core\Migrator;
use Core\Module;
use Core\ModuleInstaller;

// Modül komutlarının ortak gövdesi: php modrix module:install Blog
$moduleCommand = fn(string $verb, callable $action) => function (array $args) use ($verb, $action) {
    $name = $args[0] ?? '';
    if ($name === '') { echo "Kullanım: php modrix module:$verb Blog\n"; return 1; }
    try {
        $action($name);
    } catch (Throwable $e) {
        echo "  ✗ {$e->getMessage()}\n";
        return 1;
    }
    echo "  ✓ $name: $verb tamam\n";
};

$commands = [
