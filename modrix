        $theme = $module = null;
        foreach (array_slice($args, 1) as $a) {
            if (str_starts_with($a, '--theme=')) $theme = substr($a, 8);
            if (str_starts_with($a, '--module=')) $module = substr($a, 9);
        }
        $base = match (true) {
            $theme !== null  => ROOT . "/app/Themes/$theme/sections",
            $module !== null => ROOT . "/app/Modules/$module/Sections",
            default          => ROOT . '/app/Sections',
