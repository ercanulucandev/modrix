RewriteEngine On

# HTTP -> HTTPS (proxy/Cloudflare arkasında X-Forwarded-Proto da dikkate alınır)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Kod, ayar ve veri klasörleri dışarıdan açılamaz (uygulama 404 verir)
RewriteRule ^(app|core|storage|vendor|dist|docs)(/|$) index.php [L]
RewriteRule ^(composer\.(json|lock)|modrix|README\.md)$ index.php [L]

# .git, .gitignore vb. gizli dosyalar
RewriteRule (^|/)\. index.php [L]

# Gerçek dosya değilse uygulamaya
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
